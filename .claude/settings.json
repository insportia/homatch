    "deny": [
      "Bash(supabase db reset*)",
      "Bash(supabase projects create*)",
      "Bash(supabase projects delete*)",
      "Bash(railway delete*)",
      "Bash(vercel remove*)",
      "Bash(vercel project rm*)",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Vercel__buy_*",
      "mcp__Vercel__create_project",
      "mcp__Vercel__delete_project",
      "mcp__Vercel__pause_project",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Railway__create-project",
      "mcp__Railway__create-service",
      "mcp__Railway__delete-service",
      "mcp__Railway__delete-volume",
      "mcp__Railway__delete-bucket",
      "mcp__Railway__deploy-template",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__execute_sql|mcp__Supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sql-guard.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
