      "Bash(supabase secrets*)",
      "Bash(railway up*)",
      "Bash(railway redeploy*)",
      "Bash(railway variables*)",
      "Bash(vercel env*)",
      "Bash(vercel rm*)",
      "Bash(gh api*)",
      "Bash(gh secret*)",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__get_publishable_keys",
      "mcp__Vercel__get_auth_token",
      "mcp__Vercel__get_project_token",
      "mcp__Vercel__get_edge_config_token",
      "mcp__Railway__get-bucket-credentials",
      "mcp__Railway__redeploy",
      "mcp__Railway__create-deployment",
      "mcp__Railway__restart-service",
      "mcp__Railway__set-variables",
      "mcp__Railway__accept-deploy"
