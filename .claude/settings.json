      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git worktree*)",
      "Bash(git remote -v)",
      "Bash(git tag -l*)",
      "Bash(git cat-file*)",
