# ── HOMATCH .env.example ──────────────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to source control.
# All values here are documented — none are secrets.

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://your-domain.com
PORT=3000

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://ptxajsjhobhvsfhmutjn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For self-hosted / VPS PostgreSQL (if migrating away from Supabase)
DATABASE_URL=postgresql://user:pass@localhost:5432/homatch

# ── Extraction — Fallback Chain: Direct → ZenRows → ScrapingBee ───────────────
ZENROWS_API_KEY=
SCRAPINGBEE_API_KEY=
BRIGHTDATA_API_KEY=

# ── Search — Fallback Chain: DataForSEO → fallback ────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Social Collection (Apify) ──────────────────────────────────────────────────
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR_ID=
APIFY_TELEGRAM_ACTOR_ID=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_VK_ACTOR_ID=

# ── AI Classification ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Payments ───────────────────────────────────────────────────────────────────
# PaymentProvider is independent from Ledger/Pricing/Unlock logic
PAYMENT_PROVIDER=stripe
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com

# ── Storage ────────────────────────────────────────────────────────────────────
# Supabase Storage (default) or S3-compatible (migration path)
STORAGE_PROVIDER=supabase
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ── Monthly Spend Caps (USD) ───────────────────────────────────────────────────
# These are also stored in admin_settings table; env vars are the bootstrap defaults.
# Warning at 80%, hard block at 100%. Set high to disable effectively.
SPEND_CAP_GLOBAL=250
SPEND_CAP_DATAFORSEO=40
SPEND_CAP_APIFY=100
SPEND_CAP_ZENROWS=20
SPEND_CAP_SCRAPINGBEE=5
SPEND_CAP_BRIGHTDATA=10
SPEND_CAP_OPENAI=15

# ── Dev / Testing ─────────────────────────────────────────────────────────────
# Set to true to use mock provider responses (no real API calls, no real charges)
MOCK_DATA_PROVIDERS=false
# Set admin email for auto-granting is_admin on first login (dev only)
DEV_ADMIN_EMAIL=
