# Build inputs for the offline mobile-overflow harness (tests/mobile/).
#
# These are NOT credentials. The origin below never resolves: the test
# intercepts every request to it and answers from a fixture, which is what
# makes the run deterministic and lets it check real phone viewports without
# a session, a network or production data.
#
# Safe to commit precisely because nothing here grants access to anything.
VITE_SUPABASE_URL=https://stubproj.supabase.co
VITE_SUPABASE_ANON_KEY=stub-anon-key-not-a-credential
