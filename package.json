{
  "name": "miaoda-react-admin",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "bash scripts/lint.sh",
    "test": "node scripts/run-tests.mjs",
    "check:edge": "node scripts/check-edge-functions.mjs",
    "test:worker": "npm --prefix official-worker test",
    "test:all": "npm run test && npm run test:worker",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:keys": "node scripts/i18n-keys-check.mjs",
    "i18n:all": "node scripts/i18n-check.mjs && node scripts/i18n-keys-check.mjs && node scripts/i18n-audit.mjs && node scripts/investment-i18n-coverage.mjs && node scripts/mortgage-i18n-coverage.mjs",
    "build:harness": "vite build --mode harness",
    "test:mobile": "node --test tests/mobile/mobileOverflow.test.mjs tests/mobile/routeOverflow.test.mjs tests/mobile/chatComposer.test.mjs tests/mobile/formControls.test.mjs tests/mobile/routeHealth.test.mjs tests/mobile/textContrast.test.mjs tests/mobile/shellAndMotion.test.mjs tests/mobile/appShell.test.mjs tests/mobile/tasksAndContracts.test.mjs tests/mobile/mortgageWorkspace.test.mjs",
    "test:developer": "node --test tests/browser/developerAcceptance.test.mjs",
    "test:onboarding": "node --test tests/browser/developerOnboarding.test.mjs",
    "test:floorplan": "node --test tests/browser/floorplanPipeline.test.mjs",
    "test:studio": "node --test tests/studio/inlineEditing.test.mjs && node --test tests/studio/blocks.test.mjs && node --test tests/studio/layers.test.mjs && node --test tests/studio/translationAndHistory.test.mjs && node --test tests/studio/appContent.test.mjs && node --test tests/studio/stylePresets.test.mjs",
    "test:push": "node --test --test-timeout=300000 tests/browser/pushHandlers.test.mjs",
    "test:a11y": "node --test --test-timeout=600000 tests/browser/accessibilityAudit.test.mjs",
    "test:pwa": "node --test --test-timeout=300000 tests/browser/pwaInstallSheet.test.mjs",
    "test:browser": "npm run test:mobile && npm run test:developer && npm run test:onboarding && npm run test:floorplan && npm run test:studio && npm run test:push && npm run test:a11y && npm run test:pwa",
    "test:mobile:setup": "node scripts/setup-mobile-test.mjs",
    "test:surfaces": "npm run build:harness && node --test --test-timeout=2400000 tests/browser/commSurfaces.test.mjs",
    "studio:coverage": "node scripts/studio-coverage.mjs",
    "test:voice": "node --test src/lib/comm/__tests__/georgianCorpus.test.mjs"
  },
