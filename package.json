    "@types/video-react": "^0.15.8",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "playwright-core": "1.49.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.11",
