{
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)graphify-viewer' ':(exclude)docs' ':(exclude)tests/matrix' ':(exclude)*.md'",
  "rewrites": [
    {
      "source": "/w/:token",
      "destination": "/share.html"
    },
    {
      "source": "/d/:token",
      "destination": "/share.html"
    },
    {
      "source": "/m/a/:id",
      "destination": "https://ptxajsjhobhvsfhmutjn.supabase.co/functions/v1/email-webhook?ema=:id"
    },
    {
      "source": "/m/u",
      "destination": "https://ptxajsjhobhvsfhmutjn.supabase.co/functions/v1/outreach-unsubscribe"
    },
    {
      "source": "/m/s",
      "destination": "https://ptxajsjhobhvsfhmutjn.supabase.co/functions/v1/email-webhook"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/m/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/m/(u|s)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; img-src https: data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(w|d)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
